        "import json\n",
        "import re\n",
        "\n",
        "MIN_CHARS = 600\n",
        "MIN_PRICE = 0.5\n",
        "MAX_PRICE = 999.49\n",
        "\n",
        "MAX_TEXT_EACH = 3000\n",
        "MAX_TEXT_TOTAL = 4000\n",
        "\n",
        "REMOVALS = [\n",
        "    \"Part Number\",\n",
        "    \"Best Sellers Rank\",\n",
        "    \"Batteries Included?\",\n",
        "    \"Batteries Required?\",\n",
        "    \"Item model number\",\n",
        "]"
      ],
      "metadata": {
        "id": "L_-v5_wnbDL_"
      },
      "execution_count": 57,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def simplify(text_list):\n",
        "    return (\n",
        "        str(text_list)\n",
        "        .replace(\"\\n\", \" \")\n",
        "        .replace(\"\\r\", \"\")\n",
        "        .replace(\"\\t\", \"\")\n",
        "        .replace(\"  \", \" \")\n",
        "        .strip()[:MAX_TEXT_EACH]\n",
        "    )"
      ],
      "metadata": {
        "id": "HfwT8TMybIYr"
      },
      "execution_count": 58,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def scrub(title, description, features, details):\n",
        "\n",
        "    for remove in REMOVALS:\n",
        "        details.pop(remove, None)\n",
        "\n",
        "    result = title + \"\\n\"\n",
        "\n",
        "    if description:\n",
        "        result += simplify(description) + \"\\n\"\n",
        "\n",
        "    if features:\n",
        "        result += simplify(features) + \"\\n\"\n",
        "\n",
        "    if details:\n",
        "        result += json.dumps(details) + \"\\n\"\n",
        "\n",
        "    pattern = r\"\\b(?=[A-Z0-9]{7,}\\b)(?=.*[A-Z])(?=.*\\d)[A-Z0-9]+\\b\"\n",
        "\n",
        "    result = re.sub(pattern, \"\", result)\n",
        "\n",
        "    return result.strip()[:MAX_TEXT_TOTAL]"
      ],
      "metadata": {
        "id": "RbHyiLBsbQM_"
      },
      "execution_count": 59,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "clean_items = []\n",
        "\n",
        "for item in small_dataset:\n",
        "\n",
        "    # 1. Clean price\n",
        "    try:\n",
        "        price = float(item[\"price\"])\n",
        "    except (ValueError, TypeError):\n",
        "        continue\n",
        "\n",
        "    # 2. Check price range\n",
        "    if not MIN_PRICE <= price <= MAX_PRICE:\n",
        "        continue\n",
        "\n",
        "    # 3. Get product information\n",
        "    title = item[\"title\"]\n",
        "    description = item[\"description\"]\n",
        "    features = item[\"features\"]\n",
        "\n",
        "    # details comes from Amazon as JSON string\n",
        "    try:\n",
        "        details = json.loads(item[\"details\"])\n",
        "    except (json.JSONDecodeError, TypeError):\n",
        "        continue\n",
        "\n",
        "    # 4. Build clean text\n",
        "    full = scrub(\n",
        "        title,\n",
        "        description,\n",
        "        features,\n",
        "        details\n",
        "    )\n",
        "\n",
        "    # 5. Need enough information\n",
        "    if len(full) < MIN_CHARS:\n",
        "        continue\n",
        "\n",
        "    clean_items.append({\n",
        "        \"text\": full,\n",
        "        \"price\": price\n",
        "    })"
      ],
      "metadata": {
        "id": "Q-cpvZoSbSYQ"
      },
      "execution_count": 60,
      "outputs": []
