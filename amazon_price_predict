        "\n",
        "def plot_pricer_results(pricer, test_items, title=\"Random Pricer results\"):\n",
        "    actual_prices = []\n",
        "    predicted_prices = []\n",
        "    labels = []\n",
        "\n",
        "    # اجمع القيم\n",
        "    for item in test_items:\n",
        "        actual = item[\"price\"]\n",
        "        predicted = pricer(item)\n",
        "\n",
        "        actual_prices.append(actual)\n",
        "        predicted_prices.append(predicted)\n",
        "\n",
        "        # خذ أول سطر من الـsummary كـlabel\n",
        "        summary = item.get(\"summary\", \"\")\n",
        "        first_line = summary.split(\"\\n\")[0] if summary else \"Unknown item\"\n",
        "        labels.append(first_line)\n",
        "\n",
        "    actual_prices = np.array(actual_prices)\n",
        "    predicted_prices = np.array(predicted_prices)\n",
        "\n",
        "    # Metrics\n",
        "    mae = mean_absolute_error(actual_prices, predicted_prices)\n",
        "    mse = mean_squared_error(actual_prices, predicted_prices)\n",
        "    r2 = r2_score(actual_prices, predicted_prices)\n",
        "\n",
        "    # لون النقاط حسب حجم الخطأ\n",
        "    abs_errors = np.abs(predicted_prices - actual_prices)\n",
        "    colors = []\n",
        "    for err in abs_errors:\n",
        "        if err < 50:\n",
        "            colors.append(\"green\")\n",
        "        elif err < 150:\n",
        "            colors.append(\"orange\")\n",
        "        else:\n",
        "            colors.append(\"red\")\n",
        "\n",
        "    # Figure\n",
        "    plt.figure(figsize=(10, 7))\n",
        "    scatter = plt.scatter(actual_prices, predicted_prices, c=colors, alpha=0.8)\n",
        "\n",
        "    # خط التوقع المثالي y=x\n",
        "    max_price = max(actual_prices.max(), predicted_prices.max())\n",
        "    plt.plot([0, max_price], [0, max_price], \"--\", color=\"deepskyblue\", linewidth=1.5)\n",
